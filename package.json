{
  "name": "void-anchae",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "backend:build": "prisma generate && node scripts/build-backend.mjs",
    "backend:typecheck": "tsc -p services/api/tsconfig.json",
    "backend:start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist/backend/main.cjs",
    "backend:dev": "npm run backend:build && npm run backend:start",
    "backend:test": "node --experimental-strip-types --no-warnings --import ./tests/register.mjs --test \"tests/backend-*.test.ts\"",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --no-warnings --import ./tests/register.mjs --test \"tests/**/*.test.ts\"",
    "clean": "next clean",
    "optimize-images": "node scripts/optimize-images.mjs",
    "seed": "node scripts/seed-properties.mjs"
  },
