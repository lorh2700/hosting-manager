# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"

# 솔라피(Solapi) 알림톡/문자 — 청소매니저·호스트 알림. 네 값이 모두 있어야 실제 발송,
# 없으면 로그만 남기는 noop 으로 동작한다.
SOLAPI_API_KEY=""
SOLAPI_API_SECRET=""
SOLAPI_PFID=""
SOLAPI_FROM=""
# 알림톡 템플릿 코드 (승인된 템플릿). 비우면 해당 알림은 건너뛰거나 일반 문자로 대체.
SOLAPI_TPL_CLEANING_ASSIGNED=""
SOLAPI_TPL_CLEANING_ASSIGNED_BULK=""
SOLAPI_TPL_CLEANING_OPEN_NEW=""
# 청소 일정 취소 알림 — 코드 기본값 KA01TP2604271450581856f06opPxqMq (변수: 청소업자명, 숙소명, 청소일)
SOLAPI_TPL_CLEANING_CANCELLED=""
# 체크아웃 완료 알림 (패드 셀프 체크아웃·호스트 확인 → 청소담당자·호스트). 없으면 문자로 발송.
SOLAPI_TPL_CHECKOUT_CONFIRMED=
SOLAPI_TPL_CLEANING_APPLICATION_NEW=""
SOLAPI_TPL_TOUR_BOOKING_HOST=""
SOLAPI_TPL_TOUR_BOOKING_GUEST=""

# 인룸 패드 채팅 (welcome-pad 와 같은 Supabase 프로젝트).
# 서버: service_role 로 권한 검증 후 PostgREST 접근.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-secret-key>"
# 브라우저 Realtime 구독용 공개 키. 비우면 폴링으로 동작.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"

# ── 복도 카메라 → 체크아웃 판정 ─────────────────────────────────────────
# Reolink 카메라가 사람 감지 때 보낸 메일(사진 첨부)을 읽는 Gmail 계정. 앱 비밀번호(16자, 공백 제거)를 넣는다.
# 카메라의 "받는 사람"은 cam+<숙소slug>@gmail.com 처럼 +태그를 붙여 지점을 구분한다 (예: +byulha).
CAMERA_IMAP_USER=
CAMERA_IMAP_PASSWORD=
# CAMERA_IMAP_HOST=imap.gmail.com
# CAMERA_IMAP_PORT=993
# 사진을 넣는 Supabase Storage 비공개 버킷 (Storage 에서 미리 만들 것)
SUPABASE_STORAGE_BUCKET_CAMERA=camera-snapshots
# Claude 비전 판정 (없으면 사진만 저장하고 판정은 건너뜀)
ANTHROPIC_API_KEY=
# CHECKOUT_VISION_MODEL=claude-opus-5
