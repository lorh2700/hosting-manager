generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── 사용자 ──
model User {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String
  displayName String?   @map("display_name")
  phone       String?
  role        String    @default("host") // super_admin, admin, host, cleaner, viewer
  status      String    @default("active") // active, suspended, pending_invite
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  properties      UserProperty[]
  ownedProperties Property[]
  cleaners        Cleaner[]      @relation("OwnedCleaners")
  cleanerAccount  Cleaner?       @relation("CleanerAccount")
  invitationsSent Invitation[]   @relation("InvitedBy")
  tourOperators   TourOperator[] @relation("OwnedTourOperators")
  tours           Tour[]         @relation("OwnedTours")

  @@map("users")
}

// ── 사용자-숙소 연결 ──
model UserProperty {
  userId     String @map("user_id")
  propertyId String @map("property_id")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
  @@map("user_properties")
}

// ── 숙소 ──
model Property {
  id               String   @id @default(uuid())
  name             String
  timezone         String   @default("Asia/Seoul")
  ownerId          String   @map("owner_id")
  beds24PropId     String?  @map("beds24_prop_id")
  beds24RoomId     String?  @map("beds24_room_id")
  doorPassword     String?  @map("door_password")
  addressUrl       String?  @map("address_url")
  roomReadyMessage String?  @map("room_ready_message")
  basePrice        Decimal? @map("base_price")
  maxGuests        Int?     @map("max_guests")
  description      String?
  // Bridge to the welcome-pad project. Same Supabase DB but separate
  // schema lineage; this short key (e.g. 'anon', 'unwadang') is what
  // the pad URL uses to identify which property's settings to load.
  welcomepadKey    String?  @unique @map("welcomepad_key")
  createdAt        DateTime @default(now()) @map("created_at")

  owner                User                  @relation(fields: [ownerId], references: [id])
  users                UserProperty[]
  channels             PropertyChannel[]
  integrations         Integration[]
  events               Event[]
  bookings             Booking[]
  cleanings            Cleaning[]
  messages             Message[]
  supplyTodos          SupplyTodo[]
  supplyRequests       SupplyRequest[]
  cleaningIssues       CleaningIssue[]
  cleaningApplications CleaningApplication[]
  syncLogs             SyncLog[]
  welcomepadConfig     WelcomepadConfig?

  @@map("properties")
}

// ── 외부 API 클라이언트 (파트너사용 v1 API key) ──
// 발급 시점에만 평문 키 노출, 이후엔 sha256 해시만 DB 에 저장.
// scopes 는 'bookings:read', 'cleanings:write' 형태로 dot-style.
// propertyIds 가 비어 있으면 모든 지점 접근, 아니면 그 지점들만.
model ApiClient {
  id          String    @id @default(uuid())
  name        String                              // 파트너사 이름
  keyPrefix   String    @unique @map("key_prefix") // 'vd_live_xxxxxxxx' 식별/로그용
  keyHash     String    @unique @map("key_hash")   // sha256(전체 키)
  scopes      String[]  @default([])
  propertyIds String[]  @default([]) @map("property_ids")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  lastUsedAt  DateTime? @map("last_used_at")
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("api_clients")
}

// ── 웰컴 패드 설정 (1:1 사이드카) ──
// hotel-welcome-pad 프로젝트가 같은 DB의 anon 클라이언트로 SELECT/UPDATE.
// hosting-manager에서는 호스트가 admin UI로 편집할 때만 다룸.
model WelcomepadConfig {
  propertyId      String   @id @map("property_id")
  hotelName       String?  @map("hotel_name")
  logoType        String   @default("text") @map("logo_type")
  logoImage       String?  @map("logo_image")
  theme           String?
  themeGradient   String?  @map("theme_gradient")
  wifiSsid        String?  @map("wifi_ssid")
  wifiPassword    String?  @map("wifi_password")
  wifiEncryption  String   @default("WPA") @map("wifi_encryption")
  cleaningMode    Boolean  @default(false) @map("cleaning_mode")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("welcomepad_configs")
}

// ── 채널 ──
model PropertyChannel {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  name       String
  importUrl  String?  @map("import_url")
  exportUrl  String?  @map("export_url")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, name])
  @@map("property_channels")
}

// ── 연동 ──
model Integration {
  id                  String    @id @default(uuid())
  propertyId          String    @map("property_id")
  provider            String
  type                String    @default("ical")
  config              Json      @default("{}")
  status              String    @default("active")
  syncIntervalMinutes Int?      @default(60) @map("sync_interval_minutes")
  lastSyncAt          DateTime? @map("last_sync_at")
  lastSyncStatus      String?   @map("last_sync_status")
  lastErrorMessage    String?   @map("last_error_message")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  syncLogs SyncLog[]

  @@map("integrations")
}

// ── 이벤트 (캘린더) ──
model Event {
  id          String   @id @default(uuid())
  propertyId  String   @map("property_id")
  channelId   String?  @map("channel_id")
  source      String?
  title       String?
  startDate   String   @map("start_date") // YYYY-MM-DD
  endDate     String   @map("end_date") // YYYY-MM-DD
  type        String   @default("reservation")
  originalUid String?  @map("original_uid")
  description String?
  tags        String[] @default([])
  guestEmail  String?  @map("guest_email")
  guestPhone  String?  @map("guest_phone")
  numAdults   Int?     @map("num_adults")
  numChildren Int?     @map("num_children")
  // Welcome-pad host overrides (이전 welcomepad_current_guest 의 manual 컬럼).
  // welcomeMessage 가 set 이면 Property.roomReadyMessage 보다 우선.
  // manualReturning 가 set 이면 매칭 자동 판정을 무시하고 강제 적용.
  welcomeMessage   String?  @map("welcome_message")
  manualReturning  Boolean? @map("manual_returning")
  createdAt   DateTime @default(now()) @map("created_at")

  property Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([propertyId, channelId, originalUid])
  @@index([propertyId, type])
  @@index([propertyId, endDate])
  @@map("events")
}

// ── 예약 ──
model Booking {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  name       String?
  email      String?
  phone      String?
  guests     Int      @default(1)
  checkIn    String   @map("check_in") // YYYY-MM-DD
  checkOut   String   @map("check_out") // YYYY-MM-DD
  status     String   @default("pending") // pending, confirmed, cancelled
  message    String?
  source     String   @default("direct")
  createdAt  DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
  @@index([propertyId, status, checkOut])
  @@map("bookings")
}

// ── 게스트 ──
model Guest {
  id           String   @id @default(uuid())
  name         String?
  email        String?
  phone        String?
  bookingCount Int      @default(0) @map("booking_count")
  source       String?
  notes        String?
  lastStayAt   String?  @map("last_stay_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("guests")
}

// ── 청소 담당자 ──
model Cleaner {
  id          String   @id @default(uuid())
  name        String
  phone       String?  @unique
  publicToken String?  @unique @map("public_token")
  userId      String?  @unique @map("user_id")
  ownerId     String   @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")

  owner       User         @relation("OwnedCleaners", fields: [ownerId], references: [id])
  user        User?        @relation("CleanerAccount", fields: [userId], references: [id], onDelete: SetNull)
  cleanings   Cleaning[]
  invitations Invitation[] @relation("CleanerInvitations")

  @@map("cleaners")
}

// ── 청소 일정 ──
model Cleaning {
  id             String    @id @default(uuid())
  propertyId     String    @map("property_id")
  date           String // YYYY-MM-DD
  cleanerId      String?   @map("cleaner_id")
  status         String    @default("pending") // pending, done
  supplies       String?
  notes          String?
  completionNote String?   @map("completion_note")
  completedAt    DateTime? @map("completed_at")
  hasIssue       Boolean   @default(false) @map("has_issue")
  isOpen         Boolean   @default(false) @map("is_open")
  assignmentType String    @default("direct") @map("assignment_type")
  // 외부 파트너(예: 스테이폴리오)가 push한 청소.
  //   • externalSource = 출처 키 (e.g. 'stayfolio')
  //   • externalId     = 그쪽 시스템의 청소 ID — 멱등 update 키
  //   • externalCleanerName / Phone = 그쪽 자체 cleaner pool 을 쓸 때 (cleanerId NULL)
  //     cleanerId 가 set 이면 내부 Cleaner 풀, 그렇지 않고 externalCleanerName 이
  //     set 이면 외부 cleaner. 둘 다 NULL 이면 unassigned.
  externalSource       String? @map("external_source")
  externalId           String? @map("external_id")
  externalCleanerName  String? @map("external_cleaner_name")
  externalCleanerPhone String? @map("external_cleaner_phone")
  createdAt      DateTime  @default(now()) @map("created_at")

  property     Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  cleaner      Cleaner?              @relation(fields: [cleanerId], references: [id], onDelete: SetNull)
  applications CleaningApplication[]
  issues       CleaningIssue[]

  @@unique([externalSource, externalId])
  @@index([propertyId, date])
  @@index([cleanerId])
  @@map("cleanings")
}

// ── 청소 지원 ──
model CleaningApplication {
  id             String    @id @default(uuid())
  cleaningId     String    @map("cleaning_id")
  propertyId     String    @map("property_id")
  applicantId    String    @map("applicant_id")
  applicantName  String?   @map("applicant_name")
  status         String    @default("pending") // pending, approved, rejected
  rejectedReason String?   @map("rejected_reason")
  processedBy    String?   @map("processed_by")
  processedAt    DateTime? @map("processed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  cleaning Cleaning @relation(fields: [cleaningId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id])

  @@index([cleaningId])
  @@index([propertyId, status])
  @@map("cleaning_applications")
}

// ── 청소 이슈 ──
model CleaningIssue {
  id             String   @id @default(uuid())
  cleaningId     String?  @map("cleaning_id")
  propertyId     String   @map("property_id")
  reportedBy     String?  @map("reported_by")
  reportedByName String?  @map("reported_by_name")
  category       String? // damage, malfunction, missing, hygiene, other
  title          String?
  description    String?
  urgency        String   @default("normal") // low, normal, urgent
  status         String   @default("open") // open, in_progress, resolved, closed
  resolvedNote   String?  @map("resolved_note")
  resolvedBy     String?  @map("resolved_by")
  createdAt      DateTime @default(now()) @map("created_at")

  cleaning Cleaning? @relation(fields: [cleaningId], references: [id])
  property Property  @relation(fields: [propertyId], references: [id])

  @@index([propertyId, status])
  @@map("cleaning_issues")
}

// ── 메시지 ──
model Message {
  id                String   @id @default(uuid())
  eventId           String?  @map("event_id")
  propertyId        String?  @map("property_id")
  guestName         String?  @map("guest_name")
  text              String
  sender            String // host, guest
  read              Boolean  @default(false)
  source            String? // beds24, null
  beds24BookingId   String?  @map("beds24_booking_id")
  beds24MessageId   String?  @unique @map("beds24_message_id")
  beds24MessageType String?  @map("beds24_message_type")
  type              String   @default("message") // message, memo
  deliveryStatus    String?  @map("delivery_status") // sent, failed, local_only
  createdAt         DateTime @default(now()) @map("created_at")

  event    Event?    @relation(fields: [eventId], references: [id])
  property Property? @relation(fields: [propertyId], references: [id])

  @@index([eventId])
  @@index([propertyId])
  @@index([sender, read])
  @@index([propertyId, sender, read])
  @@map("messages")
}

// ── 비품 요청 ──
model SupplyRequest {
  id              String   @id @default(uuid())
  propertyId      String   @map("property_id")
  requestedBy     String?  @map("requested_by")
  requestedByName String?  @map("requested_by_name")
  items           Json     @default("[]")
  urgency         String   @default("normal")
  status          String   @default("pending") // pending, approved, rejected, completed
  statusNote      String?  @map("status_note")
  createdAt       DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id])

  @@map("supply_requests")
}

// ── 비품 TODO ──
model SupplyTodo {
  id         String   @id @default(uuid())
  propertyId String   @map("property_id")
  date       String? // YYYY-MM-DD
  text       String?
  done       Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  property Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId, done])
  @@map("supply_todos")
}

// ── 초대 ──
model Invitation {
  id          String   @id @default(uuid())
  email       String
  role        String
  propertyIds Json     @default("[]") @map("property_ids")
  invitedBy   String?  @map("invited_by")
  cleanerId   String?  @map("cleaner_id")
  status      String   @default("pending") // pending, accepted, expired
  token       String   @unique
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  inviter User?    @relation("InvitedBy", fields: [invitedBy], references: [id])
  cleaner Cleaner? @relation("CleanerInvitations", fields: [cleanerId], references: [id], onDelete: SetNull)

  @@map("invitations")
}

// ── 동기화 로그 ──
model SyncLog {
  id            String   @id @default(uuid())
  propertyId    String?  @map("property_id")
  integrationId String?  @map("integration_id")
  channelId     String?  @map("channel_id")
  syncType      String?  @map("sync_type")
  result        Json?
  durationMs    Int?     @map("duration_ms")
  triggeredBy   String?  @map("triggered_by")
  createdAt     DateTime @default(now()) @map("created_at")

  property    Property?    @relation(fields: [propertyId], references: [id])
  integration Integration? @relation(fields: [integrationId], references: [id])

  @@map("sync_logs")
}

// ── 투어 운영업체 ──
model TourOperator {
  id            String   @id @default(uuid())
  ownerId       String   @map("owner_id")
  name          String
  contactName   String?  @map("contact_name")
  contactPhone  String?  @map("contact_phone")
  email         String?
  notifyChannel String   @default("kakao") @map("notify_channel") // kakao, email, both, none
  publicToken   String?  @unique @map("public_token")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  owner User   @relation("OwnedTourOperators", fields: [ownerId], references: [id])
  tours Tour[]

  @@index([ownerId])
  @@map("tour_operators")
}

// ── 투어 상품 ──
model Tour {
  id           String   @id @default(uuid())
  ownerId      String   @map("owner_id")
  operatorId   String?  @map("operator_id")
  title        String
  slug         String   @unique
  category     String? // hanbok, guide, tea, craft, etc
  description  String?
  meetingPoint String?  @map("meeting_point")
  durationMin  Int?     @map("duration_min") // legacy fallback when no options exist
  basePrice    Decimal? @map("base_price") // legacy fallback when no options exist
  maxGroupSize Int?     @map("max_group_size")
  images       String[] @default([])
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  owner           User                 @relation("OwnedTours", fields: [ownerId], references: [id])
  operator        TourOperator?        @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  schedules       TourSchedule[]
  bookings        TourBooking[]
  durationOptions TourDurationOption[]
  ticketTiers     TourTicketTier[]

  @@index([ownerId])
  @@index([operatorId])
  @@map("tours")
}

// ── 투어 티켓 종류 (성인/어린이/영유아 같은 가격 티어) ──
model TourTicketTier {
  id        String   @id @default(uuid())
  tourId    String   @map("tour_id")
  label     String // "성인", "어린이", "영유아"
  price     Decimal
  notes     String? // "(4-7세)" 같은 부가 설명
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  tour Tour @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId])
  @@map("tour_ticket_tiers")
}

// ── 투어 코스 옵션 (시간별 가격) ──
model TourDurationOption {
  id          String   @id @default(uuid())
  tourId      String   @map("tour_id")
  label       String? // optional display name e.g. "북촌 짧은 코스"
  durationMin Int      @map("duration_min")
  price       Decimal
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  tour     Tour          @relation(fields: [tourId], references: [id], onDelete: Cascade)
  bookings TourBooking[]

  @@index([tourId])
  @@map("tour_duration_options")
}

// ── 투어 스케줄 (날짜 + 시간 슬롯) ──
model TourSchedule {
  id          String   @id @default(uuid())
  tourId      String   @map("tour_id")
  date        String // YYYY-MM-DD
  startTime   String   @map("start_time") // HH:mm
  capacity    Int      @default(1)
  bookedCount Int      @default(0) @map("booked_count")
  status      String   @default("open") // open, closed, cancelled
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  tour     Tour          @relation(fields: [tourId], references: [id], onDelete: Cascade)
  bookings TourBooking[]

  @@unique([tourId, date, startTime])
  @@index([date, status])
  @@map("tour_schedules")
}

// ── 투어 예약 ──
model TourBooking {
  id               String    @id @default(uuid())
  tourId           String    @map("tour_id")
  scheduleId       String    @map("schedule_id")
  durationOptionId String?   @map("duration_option_id")
  bookingId        String?   @map("booking_id") // 숙박 Booking과 느슨한 연결
  name             String
  phone            String
  email            String?
  guests           Int       @default(1)
  durationMin      Int?      @map("duration_min") // snapshot at booking time
  unitPrice        Decimal?  @map("unit_price") // snapshot at booking time
  totalPrice       Decimal?  @map("total_price")
  // Tier-based ticketing snapshot (e.g. rickshaw 성인/어린이/영유아 mix).
  // Shape: [{ tierId, label, count, unitPrice }]
  tickets          Json?     @default("[]")
  language         String? // ko, en, zh, ja — preferred guide language
  meetingChoice    String?   @map("meeting_choice") // anguk_station, accommodation, custom
  meetingDetail    String?   @map("meeting_detail") // free text (e.g. 숙소명/주소)
  status           String    @default("pending") // pending, forwarded, confirmed, cancelled, completed
  forwardedAt      DateTime? @map("forwarded_at")
  message          String?
  source           String    @default("direct") // direct, admin, hanok-guest
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tour           Tour                @relation(fields: [tourId], references: [id])
  schedule       TourSchedule        @relation(fields: [scheduleId], references: [id])
  durationOption TourDurationOption? @relation(fields: [durationOptionId], references: [id], onDelete: SetNull)

  @@index([tourId, status])
  @@index([scheduleId])
  @@map("tour_bookings")
}

// ── Beds24 access token 캐시 (싱글톤) ──
// 서버리스 콜드스타트마다 /authentication/token 을 호출하면 Beds24가
// 429를 반환하므로 DB에 토큰과 만료시각을 저장해 재사용한다.
model Beds24TokenCache {
  id        String   @id
  token     String
  expiresAt DateTime @map("expires_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("beds24_token_cache")
}
